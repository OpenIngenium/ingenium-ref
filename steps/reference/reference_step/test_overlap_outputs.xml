<?xml version="1.0" encoding="UTF-8"?>
<!--' If you are using an XML editor - like oXygen - update the next line to point to your local schema copy '-->
<?xml-model href="file:../../../docs/custom_script_schema.rnc" type="application/relax-ng-compact-syntax"?>
<!--' This Reference Script/Step assumes the use of the advanced layout functionality. '-->
<custom-scripts>
    <!-- mission name is a string defined for each project -->
    <header mission_name="Test"></header>
    <!--' The ProjConfigCreateUpdateCS.py script will populate the hash/id for each script, and will update the path per the base Ingenium path.'-->
    <!--' Script path should be the relative path to the script file with respect to the custom script xml (typically stored in the same directory) '-->
    <custom_script script_name="Overlapping Outputs" script_path="reference_step.py" description="Reference Script" hash="SHA256 Hash of your script - populated by create_catalog.py" script_id="unique id of your script - populated by create_catalog.py" is_command="true">
        <!--' Custom Scripts/Step first document all the inputs/outputs the script accepts/produces '-->
        
        <!--' Time is a common general input (e.g. establishes the time range for when to look for telemetry'-->
        <!--' In the UI time is represented as a list of procedure relative times '-->
        <!--' It is passed to the client agent as DOY formatted datetime string %Y-%jT%H:%M:%S'-->
        <input_field name="start_time" description="Start Time" phase="AUTHORING" required="YES" type="TIME" default_value="CURRENT_TIME"></input_field>
        
        <!--' A Timeout is also a common input used with time - controlling when a step times out and returns'-->
        <input_field name="timeout" description="Time Out" phase="AUTHORING" required="YES" type="INT" default_value="60"></input_field>
        
        <!--' A Lookback is also a common input used with time - providing a negative offset for queries based on start time'-->
        <input_field name="lookback" description="Look Back" phase="AUTHORING" required="YES" type="INT" default_value="60"></input_field>

        <!--' A Flight Command is comma seperated string of command stem and command arguments.'-->
        <!--' It has a special UI/UX component that provides autocomplete, lookup, and a command builder based the selected dictionary.'-->
        <input_field name="flight_cmd" description="Flight Command" phase="AUTHORING" required="YES" type="FLIGHT_COMMAND"></input_field>
        
        <!--' A Sim Command is a comma seperated string of command stem and command arguments.'-->
        <!--' It has a special UI/UX component that provides autocomplete, lookup, and a command builder based the selected dictionary.'-->
        <input_field name="sim_cmd" description="Flight Command" phase="AUTHORING" required="YES" type="SIM_COMMAND"></input_field>
        
        <!--' An execution phase input can not be populated ahead of time, and the contents are not under CM/Redline/Blueline'-->
        <!--' Note that the precense of an execution phase input will make automatic execution of the step halt.'-->
        <input_field name="measured_volts" description="Measured Volts" phase="AUTHORING" required="NO" type="FLOAT" default_value="60"></input_field>
        
        <!--' Strings capture a plain text string. Often used to specify a file path on the agent computer '-->
        <input_field name="file_loc" description="Full path to target file" phase="AUTHORING" required="NO" type="STRING" default_value="/home/user/file.txt"></input_field>     
        
        <!--' A Lookback is also a common input used with time - providing a negative offset for queries based on start time'-->
        
        <!--' An entry is a repeating section of identical inputs/outputs, each with its own dedicated pass/fail status. '-->
        <!--' There can be a single entry definition per step (but it could be repeated many times) '-->      
        <!--' Entries can have inputs, ouputs, and output arrays '-->
        <!--' The value that Ingenium will display at the summary value is the display_value which should correspond to an output field in the entry'-->
        
        <script_entry>
            
            <!--' A Flight Channel is a comma seperated string of channel_id,channel name.'-->
            <!--' It has a special UI/UX component that provides autocomplete and lookup of either ID or name based on the  selected dictionary.'-->
            <input_field name="flight_channel" description="Flight Channel" phase="AUTHORING" required="YES" type="FLIGHT_TELEM" ></input_field>
            
            <!--' A SIM Channel is a comma seperated string of channel_id,channel name.'-->
            <!--' It has a special UI/UX component that provides autocomplete and lookup of either ID or name based on the  selected dictionary.'-->
            <input_field name="sim_channel" description="Sim Channel" phase="AUTHORING" required="YES" type="SIM_TELEM" ></input_field>
            
            <!--' A Flight EVR is string of EVR name.'-->
            <!--' It has a special UI/UX component that provides autocomplete and lookup of evr name based on the  selected dictionary.'-->
            <input_field name="flight_evr" description="Flight EVR" phase="AUTHORING" required="YES" type="FLIGHT_EVR" ></input_field>

            <!--' A SIM EVR is string of EVR name.'-->
            <!--' It has a special UI/UX component that provides autocomplete and lookup of evr name based on the selected dictionary.'-->
            <input_field name="sim_evr" description="SIM EVR" phase="AUTHORING" required="YES" type="SIM_EVR" ></input_field>
            
            <!--' It has a special UI/UX component that provides autocomplete and lookup of evr name based on the selected dictionary.'-->
            <!--' Represented as a checkbox in the UI.'-->
            <input_field name="bool" description="Include in Series" phase="AUTHORING" required="YES" type="BOOL" ></input_field>

            <!--' Enumerations are strings, limited by a known list of symbolics/enumerations '-->
            <input_field name="enumerated_input" description="Enumerated Input" phase="AUTHORING" required="YES" type="ENUM" default_value="ENUM_CHOICE_1"> 
                <!--' Add your enumerated choices if the type = "enum" '-->
                <enumeration>
                    <enum symbolic="ENUM_CHOICE_1"></enum>
                    <enum symbolic="ENUM_CHOICE_2"></enum>
                </enumeration>
            </input_field>
          
            <!--' Verification condition is a special Ingenium input that captures a operator (GREATER_THAN, LESS_THAN, etc) and 0-2 values depending on conditions. '-->
            <!--' Has a specific UI/UX implementation and is captured as a CSV string <operator,value,value,value> . '-->
            <input_field name="verification_cond" description="Verification Condition" phase="AUTHORING" required="YES" type="VERIFICATION_COND" ></input_field>          
          
            <output_field description="entry_output_1" name="entry_output_1" type="INT"/>
            <output_field description="entry_output_2" name="entry_output_2" type="FLOAT"/>
            <output_field description="entry_output_3" name="entry_output_3" type="INT"/>
            <output_field description="entry_output_4" name="entry_output_4" type="FLOAT"/>
            <output_field description="entry_output_5" name="entry_output_5" type="FLOAT"/>
            <output_field description="entry_output_6" name="entry_output_6" type="INT"/>
          
            <!--' Output arrays are arrays of N rows/entries of a specified set of fields '-->
            <output_array description="Entry output array" name="my_entry_output_array" max_entries="10">
                <output_array_field name="entry_output_array_field_1" description="Field 1 of entry output array" type="INT" ></output_array_field>
                <output_array_field name="entry_output_array_field_2" description="Field 2 of entry output array" type="STRING" ></output_array_field>
            </output_array>
        </script_entry>
        
        <output_field description="Start time (in DOY format) of the reference time" name="start_time_date_time" type="STRING"/>
        <output_field description="Start time (in DOY format) of the query" name="query_start" type="STRING"/>
        <output_field description="End time (in DOY format) of the query" name="query_end" type="STRING"/>
        
        <!--' Files created in the working directory of script/step can be relayed back to the Ingenium server and made available for downlink.'-->
        <!--' This could be used for specific outputs from the test vehicle e.g. XLSX/CSV or binary files.'-->
        <output_field name="file_output_1" description="Sample File" type="FILE"/>
        <output_field name="file_output_2" description="Sample File" type="FILE"/>
                
        <!--' Image files created in the working directory of script/step can be relayed back to the Ingenium server and displayed in the UI'-->
        <output_field name="image_output_1" description="Sample Image Output" type="IMAGE"/>
        <output_field name="image_output_2" description="Sample Image Output" type="IMAGE"/>
        
        <!--' A series output is a time series data set of one or more variables and information how to display name. '-->
        <!--' Data is saved in the series.json file in the working directory of the script/step and is displayed in an interactive graph in the UI'-->
        <output_field name="series_output_1" description="Sample Image Output" type="SERIES"/>
        <output_field name="series_output_2" description="Sample Image Output" type="SERIES"/>
        
        <output_array name="my_output_array" description="Output array variable. Only one output array is supported." max_entries="10">
            <output_array_field name="output_array_field_1" description="Field 1 of output array" type="INT" ></output_array_field>
            <output_array_field name="output_array_field_2" description="Field 2 of output array" type="FLOAT" ></output_array_field>
            <output_array_field name="output_array_field_3" description="Field 3 of output array" type="FLOAT" ></output_array_field>
            <output_array_field name="output_array_field_4" description="Field 4 of output array" type="INT" ></output_array_field>
            <output_array_field name="output_array_field_5" description="Field 5 of output array" type="INT" ></output_array_field>
            <output_array_field name="output_array_field_6" description="Field 6 of output array" type="FLOAT" ></output_array_field>
            <output_array_field name="output_array_field_7" description="Field 7 of output array" type="INT" ></output_array_field>            
        </output_array>
        <advanced_layout>
            <section>
                <section_header>
                    <layout_display>
                        <template template="Sending Commands and Files at {start_time} and then querying for results."></template>
                        <mouseover_display>
                            <mouseover_element field_name="start_time_date_time" display_name="Start Time"></mouseover_element>
                            <mouseover_element field_name="query_start" display_name="Query Start"></mouseover_element>
                            <mouseover_element field_name="query_end" display_name="Query End"></mouseover_element>
                        </mouseover_display>
                        <layout row="1" column="1" width="8" height="1" align="LEFT"></layout>
                    </layout_display>
                    <layout_field field_name="measured_volts">
                        <label label_content="Volts" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="1" column="10" width="2" height="1" align="LEFT"></layout>
                    </layout_field>
                </section_header>
                <section_content>
                    <layout_field field_name="start_time">
                        <label label_content="Start Time" label_loc="TOP" label_align="CENTER"></label>
                        <layout row="1" column="1" width="3" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="timeout">
                        <label label_content="Timeout (s)" label_loc="TOP" label_align="CENTER"></label>
                        <layout row="1" column="4" width="3" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="lookback">
                        <label label_content="Lookback (s)" label_loc="TOP" label_align="CENTER"></label>
                        <layout row="1" column="7" width="3" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="flight_cmd">
                        <label label_content="Flight Command" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="2" column="1" width="12" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="sim_cmd">
                        <label label_content="Simulation Command" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="3" column="1" width="12" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="file_loc">
                        <label label_content="Flight Path" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="4" column="1" width="12" height="1" align="LEFT"></layout>
                    </layout_field>        
                </section_content>
            </section>
            <entry_section>
                <section_header>
                    <layout_display>
                        <template template="User choice {enumerated_input} for channel: {flight_channel[1]}."></template>
                        <layout row="1" column="1" width="6" height="1" align="LEFT"></layout>
                    </layout_display>
                    <layout_field field_name="bool">
                        <label label_content="Include in Series" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="1" column="7" width="3" height="1" align="LEFT"></layout>
                    </layout_field>
                    <icon icon_type="STATUS">
                        <mouseover_display>
                            <mouseover_element field_name="entry_output_1" display_name="Entry Output 1"></mouseover_element>
                            <mouseover_element field_name="entry_output_2" display_name="Entry Output 2"></mouseover_element>
                            <mouseover_element field_name="entry_output_3" display_name="Entry Output 3"></mouseover_element>
                            <mouseover_element field_name="entry_output_4" display_name="Entry Output 4"></mouseover_element>
                            <mouseover_element field_name="entry_output_5" display_name="Entry Output 5"></mouseover_element>
                            <mouseover_element field_name="entry_output_6" display_name="Entry Output 6"></mouseover_element>
                        </mouseover_display>
                        <layout row="1" column="12" width="1" height="1" align="RIGHT"></layout>
                    </icon>
                </section_header>               
                <section_content>
                    <layout_field field_name="enumerated_input">
                        <label label_content="Enumerated Choice" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="1" column="1" width="4" height="1" align="CENTER"></layout>
                    </layout_field>
                    <layout_field field_name="flight_channel">
                        <label label_content="Flight Channel" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="2" column="1" width="6" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="sim_channel">
                        <label label_content="Sim Channel" label_loc="RIGHT" label_align="CENTER"></label>
                        <layout row="2" column="7" width="6" height="1" align="RIGHT"></layout>
                    </layout_field>                    
                    <layout_field field_name="flight_evr">
                        <label label_content="Flight EVR" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="3" column="1" width="6" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="sim_evr">
                        <label label_content="Sim EVR" label_loc="RIGHT" label_align="CENTER"></label>
                        <layout row="3" column="7" width="6" height="1" align="RIGHT"></layout>
                    </layout_field>
                    <layout_field field_name="verification_cond">
                        <label label_content="Verification Condition" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="4" column="1" width="12" height="1" align="LEFT"></layout>
                    </layout_field>
                </section_content>
                <section_results>
                    <table table_name="my_entry_output_array">
                        <label label_content="Entry Output Array" label_loc="BOTTOM" label_align="CENTER"></label>
                        <table_field width="4" column_label="Entry Array 1">
                            <template template="{entry_output_array_field_1}"></template>
                        </table_field>
                        <table_field width="4" column_label="Entry Array 2">
                            <template template="{entry_output_array_field_2}"></template>
                        </table_field>
                    </table>
                </section_results>                                                 
            </entry_section>
            <section>
                <section_results>
                    <layout_field field_name="file_output_1">
                        <label label_content="Output File 1" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="1" column="1" width="6" height="1" align="LEFT"></layout>
                    </layout_field>
                    <layout_field field_name="file_output_2">
                        <!--'[OFF NOMINAL TC] This file  overlaps with file 1'-->
                        <label label_content="Overlap with File 1" label_loc="LEFT" label_align="CENTER"></label>
                        <layout row="1" column="1" width="6" height="1" align="LEFT"></layout>
                    </layout_field>
                    <image_display field_name="image_output_1">
                        <!--'[OFF NOMINAL TC] This image overlaps with series 1'-->
                        <label label_content="Overlap with Series 1" label_loc="TOP" label_align="CENTER"></label>
                        <layout row="2" column="3" width="6" height="4" align="CENTER"></layout>
                    </image_display>
                    <series field_name="series_output_1">
                        <label label_content="Chart Output" label_loc="TOP" label_align="CENTER"></label>
                        <layout row="2" column="7" width="6" height="4" align="CENTER"></layout>
                    </series>
                    <series field_name="series_output_2">
                        <!--'[OFF NOMINAL TC] This series overlaps with above rows'-->
                        <label label_content="Chart Output" label_loc="TOP" label_align="CENTER"></label>
                        <layout row="4" column="1" width="8" height="4" align="CENTER"></layout>
                    </series>
                    <image_display field_name="image_output_2">
                        <!--'[OFF NOMINAL TC] This image overruns off the page'-->
                        <label label_content="Overrun" label_loc="TOP" label_align="CENTER"></label>
                        <layout row="8" column="12" width="6" height="4" align="CENTER"></layout>
                    </image_display>

                    <table table_name="my_output_array">
                        <label label_content="Awesome Table" label_loc="BOTTOM" label_align="CENTER"></label>
                        <mouseover_display>
                            <mouseover_element field_name="output_array_field_4" display_name="Output Array 4"></mouseover_element>
                            <mouseover_element field_name="output_array_field_5" display_name="Output Array 5"></mouseover_element>
                            <mouseover_element field_name="output_array_field_6" display_name="Output Array 6"></mouseover_element>
                            <mouseover_element field_name="output_array_field_7" display_name="Output Array 7"></mouseover_element>
                        </mouseover_display>
                        <table_field width="4" column_label=" Output Array 1">
                            <template template="{output_array_field_1}"></template>
                        </table_field>
                        <table_field width="4" column_label=" Output Array 2">
                            <template template="{output_array_field_2}"></template>
                        </table_field>
                        <!--'[OFF NOMINAL TC] This column in a table is too large for the available space '-->
                        <table_field width="12" column_label=" Too big Field">
                            <template template="{output_array_field_3}"></template>
                        </table_field>
                         <!--'[OFF NOMINAL TC] This column should have no room '-->
                        <table_field width="2" column_label=" Field ">
                            <template template="{output_array_field_4}"></template>
                        </table_field>
                    </table>
                </section_results>
            </section>
        </advanced_layout>
    </custom_script>
</custom-scripts>
